# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. NEVER put these values in front-end code.

# --- Database ---
# The bundled server/server.js works out of the box with local JSON files
# (server/data/*.json) — good for getting started. For real production use,
# point this at a real database and update server/server.js's
# readCollection()/writeCollection() functions to use it instead.
DATABASE_URL=postgres://user:password@host:5432/screenly

# --- AI (Claude) ---
# Server-side only. The front-end calls POST /api/ai on YOUR server;
# your server calls Anthropic with this key. It is never sent to the browser.
AI_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Auth ---
# Simple shared-secret bearer token checked by server.js on all /api/* routes.
# Leave blank only for local development.
AUTH_SECRET=change-this-to-a-long-random-string

# --- File storage (for real CV file uploads, once added) ---
# e.g. an S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, etc.)
STORAGE_BUCKET=screenly-cv-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# --- Server ---
PORT=8787
